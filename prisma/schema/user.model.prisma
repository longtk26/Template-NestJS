model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  isVerified Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  
  userRole   UserRole[]

  @@map("users")
}
